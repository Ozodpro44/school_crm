# # ─── Required ─────────────────────────────────────────────────────────────────
# DATABASE_URL=postgresql://user:password@host:5432/dbname
# JWT_SECRET=change-me-to-a-long-random-secret-min-32-chars

# # ─── Server ────────────────────────────────────────────────────────────────────
# PORT=8080
# GRPC_PORT=9090
# ENVIRONMENT=development     # development | production

# # ─── Optional: Redis (enables OTP & rate-limiting) ────────────────────────────
# REDIS_URL=redis://localhost:6379

# # ─── Optional: Email (enables password-reset flow) ────────────────────────────
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# RESEND_FROM=noreply@yourdomain.com

# # ─── Optional: Click.uz payment gateway ───────────────────────────────────────
# # Leave blank to disable Click.uz webhooks
# CLICK_MERCHANT_ID=
# CLICK_SERVICE_ID=
# CLICK_SECRET_KEY=

# # ─── Optional: Telegram payment bot ───────────────────────────────────────────
# # Leave blank to disable Telegram payment webhooks
# TELEGRAM_BOT_TOKEN=

# # ─── Optional: Log ingestion bearer token (used by Railway log forwarder) ─────
# LOGS_TOKEN=
