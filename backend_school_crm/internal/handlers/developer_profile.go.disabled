// GenerateAPIKey generates a new API key for a developer
// @Summary Generate API key
// @Description Generate a new API key for a developer
// @Tags developers
// @Produce json
// @Param id path string true "Developer ID"
// @Success 200 {object} gin.H
// @Failure 500 {object} gin.H
// @Router /developers/{id}/api-key [post]
func GenerateAPIKey(developerService *service.DeveloperService) gin.HandlerFunc {
	return func(c *gin.Context) {
		developerID := c.Param("id")
		if developerID == "" {
			c.JSON(http.StatusBadRequest, gin.H{"error": "developer_id is required"})
			return
		}

		apiKey, err := developerService.GenerateAPIKey(c.Request.Context(), developerID)
		if err != nil {
			log.Printf("[DEVELOPER] Failed to generate API key: %v", err)
			c.JSON(http.StatusInternalServerError, gin.H{"error": err.Error()})
			return
		}

		c.JSON(http.StatusOK, gin.H{
			"apiKey":  apiKey,
			"message": "API key generated successfully",
		})
	}
}

// GetDeveloperProjects retrieves all projects for a developer
// @Summary Get developer projects
// @Description Retrieve all projects for a developer
// @Tags developers
// @Produce json
// @Param id path string true "Developer ID"
// @Success 200 {array} models.DeveloperProject
// @Failure 500 {object} gin.H
// @Router /developers/{id}/projects [get]
func GetDeveloperProjects(developerService *service.DeveloperService) gin.HandlerFunc {
	return func(c *gin.Context) {
		developerID := c.Param("id")
		if developerID == "" {
			c.JSON(http.StatusBadRequest, gin.H{"error": "developer_id is required"})
			return
		}

		projects, err := developerService.GetDeveloperProjects(c.Request.Context(), developerID)
		if err != nil {
			log.Printf("[DEVELOPER] Failed to fetch projects: %v", err)
			c.JSON(http.StatusInternalServerError, gin.H{"error": err.Error()})
			return
		}

		if projects == nil {
			projects = []models.DeveloperProject{}
		}

		c.JSON(http.StatusOK, projects)
	}
}

// CreateDeveloperProject creates a new project for a developer
// @Summary Create developer project
// @Description Create a new project for a developer
// @Tags developers
// @Accept json
// @Produce json
// @Param id path string true "Developer ID"
// @Param request body models.CreateDeveloperProjectRequest true "Create project request"
// @Success 201 {object} models.DeveloperProject
// @Failure 400 {object} gin.H
// @Failure 500 {object} gin.H
// @Router /developers/{id}/projects [post]
func CreateDeveloperProject(developerService *service.DeveloperService) gin.HandlerFunc {
	return func(c *gin.Context) {
		developerID := c.Param("id")
		if developerID == "" {
			c.JSON(http.StatusBadRequest, gin.H{"error": "developer_id is required"})
			return
		}

		var req models.CreateDeveloperProjectRequest
		if err := c.ShouldBindJSON(&req); err != nil {
			c.JSON(http.StatusBadRequest, gin.H{"error": err.Error()})
			return
		}

		proj := &models.DeveloperProject{
			DeveloperID:      developerID,
			Name:             req.Name,
			Description:      req.Description,
			RepositoryURL:    req.RepositoryURL,
			DocumentationURL: req.DocumentationURL,
			Status:           "active",
		}

		if err := developerService.CreateDeveloperProject(c.Request.Context(), proj); err != nil {
			log.Printf("[DEVELOPER] Failed to create project: %v", err)
			c.JSON(http.StatusInternalServerError, gin.H{"error": err.Error()})
			return
		}

		c.JSON(http.StatusCreated, proj)
	}
}

// UpdateDeveloperProject updates a developer's project
// @Summary Update developer project
// @Description Update a developer's project
// @Tags developers
// @Accept json
// @Produce json
// @Param id path string true "Developer ID"
// @Param projectId path string true "Project ID"
// @Param request body models.UpdateDeveloperProjectRequest true "Update project request"
// @Success 200 {object} models.DeveloperProject
// @Failure 400 {object} gin.H
// @Failure 500 {object} gin.H
// @Router /developers/{id}/projects/{projectId} [put]
func UpdateDeveloperProject(developerService *service.DeveloperService) gin.HandlerFunc {
	return func(c *gin.Context) {
		projectID := c.Param("projectId")
		if projectID == "" {
			c.JSON(http.StatusBadRequest, gin.H{"error": "project_id is required"})
			return
		}

		var req models.UpdateDeveloperProjectRequest
		if err := c.ShouldBindJSON(&req); err != nil {
			c.JSON(http.StatusBadRequest, gin.H{"error": err.Error()})
			return
		}

		proj := &models.DeveloperProject{
			Name:             req.Name,
			Description:      req.Description,
			RepositoryURL:    req.RepositoryURL,
			DocumentationURL: req.DocumentationURL,
			Status:           req.Status,
		}

		if err := developerService.UpdateDeveloperProject(c.Request.Context(), projectID, proj); err != nil {
			log.Printf("[DEVELOPER] Failed to update project: %v", err)
			c.JSON(http.StatusInternalServerError, gin.H{"error": err.Error()})
			return
		}

		c.JSON(http.StatusOK, gin.H{"message": "project updated successfully"})
	}
}

// DeleteDeveloperProject deletes a developer's project
// @Summary Delete developer project
// @Description Delete a developer's project
// @Tags developers
// @Produce json
// @Param id path string true "Developer ID"
// @Param projectId path string true "Project ID"
// @Success 200 {object} gin.H
// @Failure 400 {object} gin.H
// @Failure 500 {object} gin.H
// @Router /developers/{id}/projects/{projectId} [delete]
func DeleteDeveloperProject(developerService *service.DeveloperService) gin.HandlerFunc {
	return func(c *gin.Context) {
		projectID := c.Param("projectId")
		if projectID == "" {
			c.JSON(http.StatusBadRequest, gin.H{"error": "project_id is required"})
			return
		}

		if err := developerService.DeleteDeveloperProject(c.Request.Context(), projectID); err != nil {
			log.Printf("[DEVELOPER] Failed to delete project: %v", err)
			c.JSON(http.StatusInternalServerError, gin.H{"error": err.Error()})
			return
		}

		c.JSON(http.StatusOK, gin.H{"message": "project deleted successfully"})
	}
}

// RegisterDeveloperRoutes registers developer routes
func RegisterDeveloperRoutes(router *gin.RouterGroup, developerService *service.DeveloperService) {
	log.Println("[ROUTES] Registering developer routes")

	router.GET("/developers", ListDevelopers(developerService))
	router.POST("/developers", CreateDeveloper(developerService))
	router.GET("/developers/:id", GetDeveloper(developerService))
	router.PUT("/developers/:id", UpdateDeveloper(developerService))
	router.DELETE("/developers/:id", DeleteDeveloper(developerService))
	router.POST("/developers/:id/verify", VerifyDeveloper(developerService))
	router.POST("/developers/:id/api-key", GenerateAPIKey(developerService))

	router.GET("/developers/:id/projects", GetDeveloperProjects(developerService))
	router.POST("/developers/:id/projects", CreateDeveloperProject(developerService))
	router.PUT("/developers/:id/projects/:projectId", UpdateDeveloperProject(developerService))
	router.DELETE("/developers/:id/projects/:projectId", DeleteDeveloperProject(developerService))
}
