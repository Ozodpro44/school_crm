# ─── Shared variables (set at Project level in Railway) ──────────────────────
# These are inherited by both the rest-api and grpc-server services.

DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
JWT_SECRET=your-secret-here
LOGS_TOKEN=your-logs-token-here

# ─── REST API service variables ───────────────────────────────────────────────
# PORT is set automatically by Railway — do NOT set it manually.
# The app reads os.Getenv("PORT") and defaults to 8080.

GRPC_ADDRESS=grpc-server.railway.internal:9090   # private hostname of gRPC service
RESEND_API_KEY=re_...
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=
TELEGRAM_BOT_TOKEN=

# ─── gRPC service variables ───────────────────────────────────────────────────
# PORT is set automatically by Railway.
# GRPC_PORT is read by cmd/grpc/main.go; Railway overrides it via PORT automatically.
# Set GRPC_PORT=9090 manually so the service binds to a fixed port for private networking.

GRPC_PORT=9090
