func DeleteDeveloper(developerService *service.DeveloperService) gin.HandlerFunc {
	return func(c *gin.Context) {
		developerID := c.Param("id")
		if developerID == "" {
			c.JSON(http.StatusBadRequest, gin.H{"error": "developer_id is required"})
			return
		}

		if err := developerService.DeleteDeveloper(c.Request.Context(), developerID); err != nil {
			log.Printf("[DEVELOPER] Failed to delete developer: %v", err)
