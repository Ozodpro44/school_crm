# ============================================
# API Configuration
# ============================================

# Backend API Base URL
# Local: http://localhost:8080/api
# Production: https://your-backend.up.railway.app/api
VITE_API_BASE_URL=http://localhost:8080/api

# Request timeout in milliseconds (default: 30000)
VITE_API_TIMEOUT=30000

# ============================================
# Railway Configuration (Production Only)
# ============================================

# Railway API Key for accessing logs
# Get from: https://railway.app -> Account Settings -> Tokens
VITE_RAILWAY_API_KEY=

# Railway Project ID
# Find in: https://railway.app -> Project Settings
VITE_RAILWAY_PROJECT_ID=

# ============================================
# Feature Flags
# ============================================

# Enable development mode features
VITE_DEV_MODE=true

# Enable server logs panel
VITE_SHOW_LOGS_PANEL=true

# Enable API debugging
VITE_DEBUG_API=false
