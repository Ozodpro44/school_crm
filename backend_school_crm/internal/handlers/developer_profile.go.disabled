package handlers

import (
	"log"
	"net/http"
	"strconv"

	"github.com/gin-gonic/gin"
	"github.com/school-crm/backend/internal/models"
	"github.com/school-crm/backend/internal/service"
)

// GetDeveloper retrieves a developer by ID
// @Summary Get developer
// @Description Retrieve developer profile by ID
// @Tags developers
// @Produce json
// @Param id path string true "Developer ID"
// @Success 200 {object} models.Developer
// @Failure 404 {object} gin.H
// @Failure 500 {object} gin.H
// @Router /developers/{id} [get]
func GetDeveloper(developerService *service.DeveloperService) gin.HandlerFunc {
	return func(c *gin.Context) {
		developerID := c.Param("id")
		if developerID == "" {
			c.JSON(http.StatusBadRequest, gin.H{"error": "developer_id is required"})
			return
		}

		dev, err := developerService.GetDeveloper(c.Request.Context(), developerID)
		if err != nil {
			log.Printf("[DEVELOPER] Failed to fetch developer: %v", err)
			c.JSON(http.StatusNotFound, gin.H{"error": err.Error()})
			return
		}

		c.JSON(http.StatusOK, dev)
	}
}

// ListDevelopers retrieves all developers with optional filtering
// @Summary List developers
// @Description Retrieve all developers with pagination
// @Tags developers
// @Produce json
// @Param status query string false "Filter by status (active, inactive, banned)"
// @Param limit query int false "Limit results (default 20)"
// @Param offset query int false "Offset results (default 0)"
// @Success 200 {object} gin.H
// @Failure 500 {object} gin.H
// @Router /developers [get]
func ListDevelopers(developerService *service.DeveloperService) gin.HandlerFunc {
	return func(c *gin.Context) {
		status := c.DefaultQuery("status", "")
		limit, _ := strconv.Atoi(c.DefaultQuery("limit", "20"))
		offset, _ := strconv.Atoi(c.DefaultQuery("offset", "0"))

		developers, totalCount, err := developerService.ListDevelopers(c.Request.Context(), status, limit, offset)
		if err != nil {
			log.Printf("[DEVELOPER] Failed to list developers: %v", err)
			c.JSON(http.StatusInternalServerError, gin.H{"error": err.Error()})
			return
		}

		c.JSON(http.StatusOK, gin.H{
			"data":       developers,
			"total":      totalCount,
			"limit":      limit,
			"offset":     offset,
			"count":      len(developers),
		})
	}
}

// CreateDeveloper creates a new developer profile
// @Summary Create developer
// @Description Create a new developer profile
// @Tags developers
// @Accept json
// @Produce json
// @Param request body models.CreateDeveloperRequest true "Create developer request"
// @Success 201 {object} models.Developer
// @Failure 400 {object} gin.H
// @Failure 500 {object} gin.H
// @Router /developers [post]
func CreateDeveloper(developerService *service.DeveloperService) gin.HandlerFunc {
	return func(c *gin.Context) {
		var req models.CreateDeveloperRequest
		if err := c.ShouldBindJSON(&req); err != nil {
			c.JSON(http.StatusBadRequest, gin.H{"error": err.Error()})
			return
		}

		dev := &models.Developer{
			UserID:   req.UserID,
			Username: req.Username,
			Email:    req.Email,
			FullName: req.FullName,
			Bio:      req.Bio,
			Company:  req.Company,
			Location: req.Location,
			Status:   "active",
		}

		if err := developerService.CreateDeveloper(c.Request.Context(), dev); err != nil {
			log.Printf("[DEVELOPER] Failed to create developer: %v", err)
			c.JSON(http.StatusInternalServerError, gin.H{"error": err.Error()})
			return
		}

		c.JSON(http.StatusCreated, dev)
	}
}

// UpdateDeveloper updates a developer's profile
// @Summary Update developer
// @Description Update developer profile
// @Tags developers
// @Accept json
// @Produce json
// @Param id path string true "Developer ID"
// @Param request body models.UpdateDeveloperRequest true "Update developer request"
// @Success 200 {object} models.Developer
// @Failure 400 {object} gin.H
// @Failure 404 {object} gin.H
// @Failure 500 {object} gin.H
// @Router /developers/{id} [put]
func UpdateDeveloper(developerService *service.DeveloperService) gin.HandlerFunc {
	return func(c *gin.Context) {
		developerID := c.Param("id")
		if developerID == "" {
			c.JSON(http.StatusBadRequest, gin.H{"error": "developer_id is required"})
			return
		}

		var req models.UpdateDeveloperRequest
		if err := c.ShouldBindJSON(&req); err != nil {
			c.JSON(http.StatusBadRequest, gin.H{"error": err.Error()})
			return
		}

		dev := &models.Developer{
			Username:   req.Username,
			FullName:   req.FullName,
			Bio:        req.Bio,
			AvatarURL:  req.AvatarURL,
			GitHubURL:  req.GitHubURL,
			WebsiteURL: req.WebsiteURL,
			Company:    req.Company,
			Location:   req.Location,
		}

		if err := developerService.UpdateDeveloper(c.Request.Context(), developerID, dev); err != nil {
			log.Printf("[DEVELOPER] Failed to update developer: %v", err)
			c.JSON(http.StatusNotFound, gin.H{"error": err.Error()})
			return
		}

		// Fetch updated developer
		updated, _ := developerService.GetDeveloper(c.Request.Context(), developerID)
		c.JSON(http.StatusOK, updated)
	}
}

